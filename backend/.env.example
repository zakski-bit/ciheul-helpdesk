# ==============================================================================
# CIHEUL Omnichannel Helpdesk - Environment Configuration Template
# Copy this file to .env and configure appropriate values before running.
# ==============================================================================

# Environment: "development", "testing", or "production"
# Setting ENVIRONMENT=production enforces strict validation:
# - Halts startup if SECRET_KEY is default or < 32 characters
# - Halts startup if ADMIN_PASSWORD or CS_PASSWORD are left as defaults
ENVIRONMENT=development

# Security & JWT Token Key
# In production, generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=ciheul-secret-key-3489274982374982374

# Seed Credentials (Mandatory custom values in production)
ADMIN_EMAIL=admin@ciheul.com
ADMIN_PASSWORD=admin123
CS_EMAIL=cs@ciheul.com
CS_PASSWORD=cs123

# Database Connection URL (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./helpdesk.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/ciheul_helpdesk

# CORS Origins (comma-separated list of allowed domains)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Optional Google Gemini API Key for Copilot AI Features
# GEMINI_API_KEY=your_gemini_api_key_here
